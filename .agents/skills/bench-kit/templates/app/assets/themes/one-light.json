{
  "name": "One Light",
  "appearance": "light",
  "style": {
    "editor.background": "#FAFAFA",
    "editor.foreground": "#383A42",
    "editor.active_line.background": "#EFEFF080",
    "editor.line_number": "#B0B1B6",
    "editor.active_line_number": "#383A42",
    "editor.invisible": "#A0A1A766",
    "syntax": {
      "attribute": { "color": "#986801" },
      "boolean": { "color": "#986801" },
      "comment": { "color": "#A0A1A7", "font_style": "italic" },
      "comment.doc": { "color": "#A0A1A7", "font_style": "italic" },
      "constant": { "color": "#986801" },
      "constructor": { "color": "#4078F2" },
      "embedded": { "color": "#383A42" },
      "emphasis": { "font_style": "italic" },
      "emphasis.strong": { "font_weight": 700 },
      "enum": { "color": "#C18401" },
      "function": { "color": "#4078F2" },
      "keyword": { "color": "#A626A4" },
      "label": { "color": "#4078F2" },
      "link_text": { "color": "#4078F2", "font_style": "normal" },
      "link_uri": { "color": "#0184BC", "font_style": "italic" },
      "number": { "color": "#986801" },
      "operator": { "color": "#0184BC" },
      "property": { "color": "#E45649" },
      "punctuation": { "color": "#383A42" },
      "punctuation.bracket": { "color": "#383A42" },
      "punctuation.delimiter": { "color": "#383A42" },
      "punctuation.list_marker": { "color": "#E45649" },
      "punctuation.special": { "color": "#0184BC" },
      "string": { "color": "#50A14F" },
      "string.escape": { "color": "#0184BC" },
      "string.regex": { "color": "#0184BC" },
      "string.special": { "color": "#0184BC" },
      "string.special.symbol": { "color": "#0184BC" },
      "tag": { "color": "#E45649" },
      "tag.doctype": { "color": "#A626A4" },
      "text.literal": { "color": "#50A14F" },
      "text.code.span": { "color": "#50A14F" },
      "title": { "color": "#E45649", "font_weight": 700 },
      "type": { "color": "#C18401" },
      "variable": { "color": "#383A42" },
      "variable.special": { "color": "#E45649" },
      "primary": { "color": "#383A42" },
      "predictive": { "color": "#A0A1A7" }
    }
  }
}
