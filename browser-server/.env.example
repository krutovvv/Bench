# Copy to .env and fill in.

# The browser's address (a DNS record pointing at this server).
BROWSER_HOST=browser.example.com

# Basic auth for the agent's MCP: `htpasswd -nb agent <password>`, each $ written as $$.
# The agent sends the same user and password as "Authorization: Basic base64(agent:<password>)".
MCP_BASIC_AUTH=agent:$$apr1$$replace$$withYourOwnHash

# The browser's language for sites (Accept-Language, navigator.language): en-US, de-DE, ru-RU…
BROWSER_LANG=en-US

# The Docker network Traefik watches.
PROXY_NETWORK=proxy
