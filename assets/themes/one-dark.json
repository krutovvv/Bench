{
  "name": "One Dark",
  "appearance": "dark",
  "style": {
    "editor.background": "#282C33",
    "editor.foreground": "#ACB2BE",
    "editor.active_line.background": "#2F343E80",
    "editor.line_number": "#4E5A5F",
    "editor.active_line_number": "#D0D4DA",
    "editor.invisible": "#878A9866",
    "syntax": {
      "attribute": { "color": "#74ADE8" },
      "boolean": { "color": "#BF956A" },
      "comment": { "color": "#5D636F", "font_style": "italic" },
      "comment.doc": { "color": "#878E98", "font_style": "italic" },
      "constant": { "color": "#DFC184" },
      "constructor": { "color": "#73ADE9" },
      "embedded": { "color": "#DCE0E5" },
      "emphasis": { "font_style": "italic" },
      "emphasis.strong": { "font_weight": 700 },
      "enum": { "color": "#D07277" },
      "function": { "color": "#73ADE9" },
      "keyword": { "color": "#B477CF" },
      "label": { "color": "#74ADE8" },
      "link_text": { "color": "#73ADE9", "font_style": "normal" },
      "link_uri": { "color": "#6EB4BF", "font_style": "italic" },
      "number": { "color": "#BF956A" },
      "operator": { "color": "#6EB4BF" },
      "property": { "color": "#D07277" },
      "punctuation": { "color": "#ACB2BE" },
      "punctuation.bracket": { "color": "#B2B9C6" },
      "punctuation.delimiter": { "color": "#B2B9C6" },
      "punctuation.list_marker": { "color": "#D07277" },
      "punctuation.special": { "color": "#B1574B" },
      "string": { "color": "#A1C181" },
      "string.escape": { "color": "#878E98" },
      "string.regex": { "color": "#C0966B" },
      "string.special": { "color": "#BF956A" },
      "string.special.symbol": { "color": "#BF956A" },
      "tag": { "color": "#74ADE8" },
      "tag.doctype": { "color": "#B477CF" },
      "text.literal": { "color": "#A1C181" },
      "text.code.span": { "color": "#A1C181" },
      "title": { "color": "#D07277", "font_weight": 700 },
      "type": { "color": "#6EB4BF" },
      "variable": { "color": "#ACB2BE" },
      "variable.special": { "color": "#BF956A" },
      "primary": { "color": "#ACB2BE" },
      "predictive": { "color": "#5D636F" }
    }
  }
}
