{
  "name": "GitHub Light",
  "appearance": "light",
  "style": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#1F2328",
    "editor.active_line.background": "#F6F8FA",
    "editor.line_number": "#8C959F",
    "editor.active_line_number": "#1F2328",
    "editor.invisible": "#D0D7DE",
    "error": "#CF222E",
    "warning": "#BF8700",
    "success": "#1A7F37",
    "info": "#0969DA",
    "hint": "#6E7781",
    "syntax": {
      "attribute": {
        "color": "#0550AE"
      },
      "boolean": {
        "color": "#0550AE"
      },
      "comment": {
        "color": "#6E7781",
        "font_style": "italic"
      },
      "comment_doc": {
        "color": "#6E7781",
        "font_style": "italic"
      },
      "constant": {
        "color": "#0550AE"
      },
      "constructor": {
        "color": "#8250DF"
      },
      "embedded": {
        "color": "#1F2328"
      },
      "emphasis": {
        "font_style": "italic"
      },
      "emphasis.strong": {
        "font_weight": 700
      },
      "enum": {
        "color": "#953800"
      },
      "function": {
        "color": "#8250DF"
      },
      "hint": {
        "color": "#6E7781"
      },
      "keyword": {
        "color": "#CF222E"
      },
      "label": {
        "color": "#0550AE"
      },
      "link_text": {
        "color": "#8250DF",
        "font_style": "normal"
      },
      "link_uri": {
        "color": "#0550AE",
        "font_style": "italic"
      },
      "number": {
        "color": "#0550AE"
      },
      "operator": {
        "color": "#CF222E"
      },
      "property": {
        "color": "#0550AE"
      },
      "punctuation": {
        "color": "#1F2328"
      },
      "punctuation.bracket": {
        "color": "#656D76"
      },
      "punctuation.delimiter": {
        "color": "#656D76"
      },
      "punctuation.list_marker": {
        "color": "#CF222E"
      },
      "punctuation.special": {
        "color": "#0A3069"
      },
      "string": {
        "color": "#0A3069"
      },
      "string.escape": {
        "color": "#0A3069"
      },
      "string.regex": {
        "color": "#0A3069"
      },
      "string.special": {
        "color": "#0550AE"
      },
      "string.special.symbol": {
        "color": "#0550AE"
      },
      "tag": {
        "color": "#116329"
      },
      "tag.doctype": {
        "color": "#CF222E"
      },
      "text.literal": {
        "color": "#0A3069"
      },
      "text.code.span": {
        "color": "#0A3069"
      },
      "title": {
        "color": "#CF222E",
        "font_weight": 700
      },
      "type": {
        "color": "#953800"
      },
      "variable": {
        "color": "#953800"
      },
      "variable.special": {
        "color": "#0550AE"
      },
      "primary": {
        "color": "#1F2328"
      },
      "predictive": {
        "color": "#6E7781"
      },
      "preproc": {
        "color": "#CF222E"
      },
      "variant": {
        "color": "#0550AE"
      }
    }
  }
}
