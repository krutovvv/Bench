{
  "name": "IntelliJ Light",
  "appearance": "light",
  "style": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editor.active_line.background": "#F2F2F2",
    "editor.line_number": "#737373",
    "editor.active_line_number": "#000000",
    "editor.invisible": "#A0A0A0",
    "error": "#D80606",
    "warning": "#CC7A00",
    "success": "#067D17",
    "info": "#0000C0",
    "hint": "#8C8C8C",
    "syntax": {
      "attribute": {
        "color": "#871094"
      },
      "boolean": {
        "color": "#1750EB"
      },
      "comment": {
        "color": "#8C8C8C",
        "font_style": "italic"
      },
      "comment_doc": {
        "color": "#526D8A",
        "font_style": "italic"
      },
      "constant": {
        "color": "#0000C0"
      },
      "constructor": {
        "color": "#00627A"
      },
      "embedded": {
        "color": "#000000"
      },
      "emphasis": {
        "font_style": "italic"
      },
      "emphasis.strong": {
        "font_weight": 700
      },
      "enum": {
        "color": "#A02AA6"
      },
      "function": {
        "color": "#00627A"
      },
      "hint": {
        "color": "#8C8C8C"
      },
      "keyword": {
        "color": "#0033B3"
      },
      "label": {
        "color": "#871094"
      },
      "link_text": {
        "color": "#00627A",
        "font_style": "normal"
      },
      "link_uri": {
        "color": "#0000C0",
        "font_style": "italic"
      },
      "number": {
        "color": "#1750EB"
      },
      "operator": {
        "color": "#000000"
      },
      "property": {
        "color": "#871094"
      },
      "punctuation": {
        "color": "#000000"
      },
      "punctuation.bracket": {
        "color": "#000000"
      },
      "punctuation.delimiter": {
        "color": "#000000"
      },
      "punctuation.list_marker": {
        "color": "#D80606"
      },
      "punctuation.special": {
        "color": "#067D17"
      },
      "string": {
        "color": "#067D17"
      },
      "string.escape": {
        "color": "#067D17"
      },
      "string.regex": {
        "color": "#871094"
      },
      "string.special": {
        "color": "#1750EB"
      },
      "string.special.symbol": {
        "color": "#1750EB"
      },
      "tag": {
        "color": "#000080"
      },
      "tag.doctype": {
        "color": "#0033B3"
      },
      "text.literal": {
        "color": "#067D17"
      },
      "text.code.span": {
        "color": "#067D17"
      },
      "title": {
        "color": "#D80606",
        "font_weight": 700
      },
      "type": {
        "color": "#A02AA6"
      },
      "variable": {
        "color": "#000000"
      },
      "variable.special": {
        "color": "#1750EB"
      },
      "primary": {
        "color": "#000000"
      },
      "predictive": {
        "color": "#8C8C8C"
      },
      "preproc": {
        "color": "#0033B3"
      },
      "variant": {
        "color": "#A02AA6"
      }
    }
  }
}
