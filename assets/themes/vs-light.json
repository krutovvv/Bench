{
  "name": "VS Code Light+",
  "appearance": "light",
  "style": {
    "editor.background": "#FFFFFF",
    "editor.foreground": "#000000",
    "editor.active_line.background": "#F2F2F2",
    "editor.line_number": "#237893",
    "editor.active_line_number": "#0B216F",
    "editor.invisible": "#A5A5A5",
    "syntax": {
      "attribute": {
        "color": "#FF0000"
      },
      "boolean": {
        "color": "#098658"
      },
      "comment": {
        "color": "#008000",
        "font_style": "italic"
      },
      "comment.doc": {
        "color": "#008000",
        "font_style": "italic"
      },
      "constant": {
        "color": "#0070C1"
      },
      "constructor": {
        "color": "#795E26"
      },
      "embedded": {
        "color": "#000000"
      },
      "emphasis": {
        "font_style": "italic"
      },
      "emphasis.strong": {
        "font_weight": 700
      },
      "enum": {
        "color": "#267F99"
      },
      "function": {
        "color": "#795E26"
      },
      "keyword": {
        "color": "#0000FF"
      },
      "label": {
        "color": "#FF0000"
      },
      "link_text": {
        "color": "#795E26",
        "font_style": "normal"
      },
      "link_uri": {
        "color": "#0451A5",
        "font_style": "italic"
      },
      "number": {
        "color": "#098658"
      },
      "operator": {
        "color": "#000000"
      },
      "property": {
        "color": "#001080"
      },
      "punctuation": {
        "color": "#000000"
      },
      "punctuation.bracket": {
        "color": "#000000"
      },
      "punctuation.delimiter": {
        "color": "#000000"
      },
      "punctuation.list_marker": {
        "color": "#CD3131"
      },
      "punctuation.special": {
        "color": "#0000FF"
      },
      "string": {
        "color": "#A31515"
      },
      "string.escape": {
        "color": "#0000FF"
      },
      "string.regex": {
        "color": "#811F3F"
      },
      "string.special": {
        "color": "#098658"
      },
      "string.special.symbol": {
        "color": "#098658"
      },
      "tag": {
        "color": "#800000"
      },
      "tag.doctype": {
        "color": "#0000FF"
      },
      "text.literal": {
        "color": "#A31515"
      },
      "text.code.span": {
        "color": "#A31515"
      },
      "title": {
        "color": "#CD3131",
        "font_weight": 700
      },
      "type": {
        "color": "#267F99"
      },
      "variable": {
        "color": "#001080"
      },
      "variable.special": {
        "color": "#098658"
      },
      "primary": {
        "color": "#000000"
      },
      "predictive": {
        "color": "#008000"
      }
    }
  }
}
